{
  "conditions": [
    { "op": "eq", "args": "[路径, 值]", "desc": "等于" },
    { "op": "neq", "args": "[路径, 值]", "desc": "不等于" },
    { "op": "gt", "args": "[路径, 值]", "desc": "大于（开区间）" },
    { "op": "gte", "args": "[路径, 值]", "desc": "大于等于" },
    { "op": "lt", "args": "[路径, 值]", "desc": "小于" },
    { "op": "lte", "args": "[路径, 值]", "desc": "小于等于" },
    { "op": "between", "args": "[路径, 下, 上]", "desc": "闭区间，可写 null" },
    { "op": "in", "args": "[路径, [值…]]", "desc": "属于集合" },
    { "op": "has", "args": "[路径, 数量]", "desc": "物品/标记 ≥ n" },
    { "op": "flag", "args": "标记名", "desc": "标记为真" },
    { "op": "notFlag", "args": "标记名", "desc": "标记为假" },
    { "op": "stage", "args": "meng|fu|tai|none", "desc": "学籍阶段（语法糖）" },
    { "op": "realm", "args": "{dao, gte}", "desc": "境界层级（语法糖）" },
    { "op": "zone", "args": "city|wild|battle", "desc": "当前场景" },
    { "op": "all", "args": "[…]", "desc": "全真" },
    { "op": "any", "args": "[…]", "desc": "任一真" },
    { "op": "not", "args": "{…}", "desc": "取反" },
    { "op": "none", "args": "[…]", "desc": "全假" },
    { "op": "count", "args": "{of, gte}", "desc": "满足 n 条以上" },
    { "op": "chance", "args": "{p, luck}", "desc": "随机（必须显式 luck）" },
    { "op": "judge", "args": "{kind, …}", "desc": "具名判定器（唯一公式入口）" },
    { "op": "use", "args": "{条件组, args}", "desc": "引用 data/conditions.json" }
  ],
  "effects": [
    { "op": "add", "args": "[路径, 数值]", "desc": "加" },
    { "op": "sub", "args": "[路径, 数值]", "desc": "减" },
    { "op": "mul", "args": "[路径, 系数]", "desc": "乘（禁止用于修为条）" },
    { "op": "set", "args": "[路径, 值]", "desc": "赋值" },
    { "op": "clampAdd", "args": "[路径, 数值, 下, 上]", "desc": "加并钳制" },
    { "op": "money", "args": "{copper|silver|gold}", "desc": "货币（走进位）" },
    { "op": "mod", "args": "{target, op, value, duration, source}", "desc": "修饰器（永久/临时）" },
    { "op": "unmod", "args": "source", "desc": "移除修饰器" },
    { "op": "grant", "args": "{item, n}", "desc": "给物品" },
    { "op": "flag", "args": "{id, value}", "desc": "写标记" },
    { "op": "chain", "args": "{event, delayMonths}", "desc": "排后续事件" },
    { "op": "log", "args": "文案", "desc": "写日志" },
    { "op": "if", "args": "{when, then, else}", "desc": "条件分支" },
    { "op": "each", "args": "{list, as, do}", "desc": "遍历" },
    { "op": "roll", "args": "{table, n, as}", "desc": "权重表抽取" },
    { "op": "call", "args": "{macro, args}", "desc": "调用宏" }
  ]
}
